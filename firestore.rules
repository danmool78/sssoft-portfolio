rules_version = '2';
// 홈페이지 아이디어 접수 폼 전용 규칙.
// 누구나 ideas에 새 글을 남길 수만 있고, 읽기·수정·삭제는 사이트에서 막는다 (Firebase 콘솔에서만 확인).
service cloud.firestore {
  match /databases/{database}/documents {
    match /ideas/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'contact', 'idea', 'page', 'createdAt'])
        && request.resource.data.contact is string
        && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 100
        && request.resource.data.idea is string
        && request.resource.data.idea.size() > 0 && request.resource.data.idea.size() <= 3000
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 50
        && request.resource.data.get('page', '') is string
        && request.resource.data.get('page', '').size() <= 100
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
